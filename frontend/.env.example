# ==============================================================================
# JobFalcon Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to `frontend/.env.local` for local Next.js frontend development.
#
# NOTE: Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser client.
# Do not store secrets or private tokens in frontend environment variables.
# ==============================================================================

# Backend FastAPI Gateway Base URL
# - Local development (direct host execution): http://localhost:8000
# - Docker Compose: http://localhost:8000 (browser executes client-side on the host machine)
# - Remote / Hosted deployment: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
