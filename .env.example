# ==============================================================================
# JobFalcon — Root Environment Configuration Template (.env.example)
# Copy this file to .env at the project root for Docker Compose or full-stack runs.
# ==============================================================================

# Backend Port & Host Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend AI Gateway & Search
LLM_PROVIDER=mock
LLM_MODEL=qwen2.5:14b-instruct
WEB_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080

# Frontend Next.js Public API URL (accessible by browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional PostgreSQL / Redis Stack (for --profile full)
POSTGRES_PASSWORD=devpassword123
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
