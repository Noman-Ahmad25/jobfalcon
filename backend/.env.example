# ==============================================================================
# JobFalcon Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` for local backend development or adjust in
# `docker-compose.yml` for multi-container deployments.
#
# NOTE: Never commit sensitive credentials, production tokens, or `.env` files to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Metadata & Server Bind
# ------------------------------------------------------------------------------
# Application runtime environment: "development", "testing", or "production"
ENVIRONMENT=development

# Enable FastAPI debug mode and verbose traceback logging (set to false in production)
DEBUG=true

# API routing prefix for versioned endpoints
API_V1_PREFIX=/api/v1

# Network interface host address to bind the uvicorn server (0.0.0.0 binds all interfaces)
HOST=0.0.0.0

# TCP port to listen on
PORT=8000

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Persistence Configuration
# ------------------------------------------------------------------------------
# Database connection URL.
# - SQLite default: Zero-setup file-based persistence for local development and tests
DATABASE_URL=sqlite:///./jobfalcon_dev.db

# - PostgreSQL (Docker Compose full profile with pgvector extension):
# DATABASE_URL=postgresql+asyncpg://jobfalcon_user:devpassword123@localhost:5432/jobfalcon

# ------------------------------------------------------------------------------
# 3. LLM / AI Gateway Configuration
# ------------------------------------------------------------------------------
# Model provider strategy:
# - "mock": Offline deterministic mock responses (zero API keys required, ideal for testing)
# - "litellm": LiteLLM proxy router gateway
# - "ollama": Direct local Ollama runner
# - "openai": OpenAI / OpenAI-compatible API endpoints
LLM_PROVIDER=mock

# Provider API key or LiteLLM gateway token (leave empty for mock or local Ollama)
LLM_API_KEY=

# Base URL for LLM provider / OpenAI-compatible endpoint
# - Ollama default: http://localhost:11434/v1
# - LiteLLM default: http://localhost:4000/v1
LLM_BASE_URL=http://localhost:4000/v1

# Target model identifier (e.g. "qwen2.5:14b-instruct", "llama3.1:8b-instruct", "gpt-4o-mini")
LLM_MODEL=qwen2.5:14b-instruct

# Client timeout for LLM inferences in seconds
LLM_TIMEOUT_SECONDS=30.0

# Maximum number of retry attempts for failed LLM invocations before fallback
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 4. Candidate Profiling Limits
# ------------------------------------------------------------------------------
# Maximum characters accepted from uploaded resume/document text before chunking/truncation
PROFILING_MAX_INPUT_CHARS=25000

# ------------------------------------------------------------------------------
# 5. Web Search Configuration (Privacy-Preserving & Deterministic Discovery)
# ------------------------------------------------------------------------------
# Search provider strategy:
# - "searxng": Self-hosted SearXNG meta-search engine (default in docker-compose)
# - "duckduckgo": Public DuckDuckGo search fallback
# - "mock": Deterministic offline synthetic responses
WEB_SEARCH_PROVIDER=searxng

# Base URL for SearXNG service instance (must include /search JSON API capability)
# - When running backend on host: http://localhost:8080
# - When running backend inside Docker Compose network: http://searxng:8080
SEARXNG_BASE_URL=http://localhost:8080

# Optional API key or bearer token if your search endpoint requires authentication
WEB_SEARCH_API_KEY=

# Search HTTP request timeout in seconds
WEB_SEARCH_TIMEOUT_SECONDS=6.0

# Maximum organic search results requested per search query
WEB_SEARCH_MAX_RESULTS=10

# Whether to perform shallow HTTP HEAD/GET verification on discovered destination URLs
WEB_SEARCH_ENRICH_DESTINATIONS=false

# ------------------------------------------------------------------------------
# 6. Model Context Protocol (MCP) — JobSpy Connector
# ------------------------------------------------------------------------------
# Command executable or binary path for JobSpy MCP server (runs via stdio transport)
MCP_JOBSPY_COMMAND=mcp-jobspy

# Timeout in seconds for individual MCP stdio tool calls
MCP_JOBSPY_TIMEOUT_SECONDS=12.0

# Number of opportunity results requested per job board during scraping
MCP_JOBSPY_RESULTS_WANTED=5

# Whether to invoke MCP get_job_details to enrich full descriptions and direct URLs
MCP_JOBSPY_FETCH_DETAILS=true

# Default ISO country name/code for JobSpy scrapers (e.g., "usa", "india", "uk", "canada")
MCP_JOBSPY_COUNTRY=usa

# ------------------------------------------------------------------------------
# 7. Adaptive Discovery & Orchestration Budgets (Milestone 15)
# ------------------------------------------------------------------------------
# Execution mode profile:
# - "local": Generous exploration budgets for local developer workstation with zero LLM API cost concerns
# - "hosted": Strict concurrency and iteration ceilings for multi-tenant hosted environments
DISCOVERY_EXECUTION_MODE=local

# Maximum search-evaluate-adapt loop iterations (default: 6 for local, 3 for hosted)
DISCOVERY_MAX_ITERATIONS=6

# Maximum total external tool calls across all connectors (0 = unlimited; default: 30 for local, 10 for hosted)
DISCOVERY_MAX_TOOL_CALLS=30

# Maximum tool calls permitted per connector type (Web Search or MCP JobSpy) within a single run
DISCOVERY_MAX_CALLS_PER_CONNECTOR=15

# Maximum concurrent search tool calls executed in parallel
DISCOVERY_MAX_CONCURRENT_CONNECTOR_CALLS=3

# Timeout in seconds for individual connector search executions
DISCOVERY_PER_TOOL_TIMEOUT_SECONDS=20.0

# Overall discovery workflow execution timeout in seconds before safely concluding with partial results
DISCOVERY_WORKFLOW_TIMEOUT_SECONDS=120.0

# Maximum retry attempts per failed connector call before marking provider degraded
DISCOVERY_RETRY_LIMIT=2

# ------------------------------------------------------------------------------
# 8. Demo Data Seeding
# ------------------------------------------------------------------------------
# If true, seeds initial demo candidate profiles and opportunities on startup.
# Disable (false) in real local-user workflows to avoid polluting user profile state.
SEED_DEMO_DATA=false
