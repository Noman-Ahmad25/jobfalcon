# ==============================================================================
# JobFalcon Backend Environment Configuration (Example)
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# API Server Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence Configuration (SQLite default for zero-setup local dev; PostgreSQL supported)
DATABASE_URL=sqlite:///./jobfalcon_dev.db
# DATABASE_URL=postgresql+asyncpg://jobfalcon_user:devpassword123@localhost:5432/jobfalcon

# LLM / AI Gateway Configuration
# Options: mock (default for offline/testing), litellm, ollama, openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=qwen2.5:14b-instruct
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Candidate Profiling Limits
PROFILING_MAX_INPUT_CHARS=25000

